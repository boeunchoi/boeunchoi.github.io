---
layout: default
---
{% assign is_ko = false %}
{% if page.lang == 'ko' %}{% assign is_ko = true %}{% endif %}

<div class="post research-page">
  <header class="post-header">
    <h1 class="post-title">{{ page.heading | default: 'Gallery' }}</h1>
    <div class="accent-rule"></div>
  </header>

  {{ content }}

  <nav class="gallery-jump">
    {% for section in site.data.gallery %}
      {% if section.items and section.items.size > 0 %}
        {% assign sid = section.id | default: section.title | slugify %}
        {% if is_ko and section.title_ko %}{% assign stitle = section.title_ko %}{% else %}{% assign stitle = section.title %}{% endif %}
        <a class="link-box" href="#{{ sid }}">{{ stitle }}</a>
      {% endif %}
    {% endfor %}
  </nav>

  {% for section in site.data.gallery %}
    {% if section.items and section.items.size > 0 %}
      {% assign sid = section.id | default: section.title | slugify %}
      {% if is_ko and section.title_ko %}{% assign stitle = section.title_ko %}{% else %}{% assign stitle = section.title %}{% endif %}
      {% if is_ko and section.description_ko -%}
        {%- assign sdesc = section.description_ko -%}
      {%- else -%}
        {%- assign sdesc = section.description -%}
      {%- endif %}
      <section class="gallery-section" id="{{ sid }}">
        <h2 class="section-label">
          <a href="#{{ sid }}">{{ stitle }}</a>
        </h2>
        {% if sdesc %}
          <p class="gallery-desc">{{ sdesc }}</p>
        {% endif %}
        <div class="gallery-grid{% if section.thumb %} thumb-{{ section.thumb }}{% endif %}">
          {% for item in section.items %}
            <div class="gallery-item">
              {% include figure.liquid path=item.image alt=item.caption class="img-fluid" zoomable=true %}
              {% if item.caption %}
                <p class="small-caption">{{ item.caption }}</p>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </section>
    {% endif %}
  {% endfor %}
</div>
