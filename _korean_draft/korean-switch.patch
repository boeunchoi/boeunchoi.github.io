diff --git a/assets/css/custom.css b/assets/css/custom.css
index b2de7a8..a8336aa 100644
--- a/assets/css/custom.css
+++ b/assets/css/custom.css
@@ -625,3 +625,60 @@ html {
   font-size: 0.85rem;
   border-radius: 18px;
 }
+
+/* ---------- Language switch (EN <-> 한) in the menu bar ---------- */
+.lang-container {
+  display: flex;
+  align-items: center;
+  margin-left: 0.75rem;
+}
+
+.lang-switch {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  min-height: 44px; /* easy to tap */
+  font-size: 0.8rem;
+  letter-spacing: 0.04em;
+  text-decoration: none !important;
+}
+
+.lang-label {
+  color: var(--global-text-color-light);
+  opacity: 0.55;
+  transition: opacity 0.2s ease, color 0.2s ease;
+}
+
+.lang-switch:not(.is-ko) .lang-en,
+.lang-switch.is-ko .lang-ko {
+  color: var(--global-text-color);
+  opacity: 1;
+}
+
+.lang-track {
+  position: relative;
+  width: 30px;
+  height: 16px;
+  border: 1.2px solid var(--global-text-color-light);
+  border-radius: 999px;
+  opacity: 0.8;
+}
+
+.lang-knob {
+  position: absolute;
+  top: 2px;
+  left: 2px;
+  width: 10px;
+  height: 10px;
+  border-radius: 50%;
+  background: var(--global-theme-color);
+  transition: transform 0.2s ease;
+}
+
+.lang-switch.is-ko .lang-knob {
+  transform: translateX(14px);
+}
+
+.lang-switch:hover .lang-track {
+  border-color: var(--global-theme-color);
+}
